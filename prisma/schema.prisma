generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                     String                  @id @default(uuid())
  email                  String?                 @unique
  username               String                  @unique
  name                   String
  password               String
  role                   Role
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  jobTitle               String?
  schoolName             String?
  specialty              String?
  faceDescriptor         String?
  phone                  String?
  image                  String?
  pushSubscription       String?
  announcements          Announcement[]          @relation("AnnouncementsCreated")
  announcementRecipients AnnouncementRecipient[]
  attendances            Attendance[]
  classesTaught          ClassOnTeacher[]
  inquestsCreated        Inquest[]               @relation("InquestsCreated")
  inquestsReceived       Inquest[]               @relation("InquestsReceived")
  leaveRequests          LeaveRequest[]
  lessons                Lesson[]
  notifications          Notification[]
  passwordResetTokens    PasswordResetToken[]
  createdSchedules       Schedule[]              @relation("ScheduleCreator")
  scheduleItems          ScheduleItem[]
  subjectsTaught         SubjectOnTeacher[]
  absences               Substitution[]          @relation("AbsentTeacher")
  replacements           Substitution[]          @relation("ReplacementTeacher")
  weeklyReports          WeeklyReport[]

  lessonPlans LessonPlan[]
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  token     String
  expires   DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Class {
  id            String           @id @default(uuid())
  name          String           @unique
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  teachers      ClassOnTeacher[]
  lessons       Lesson[]
  schedules     Schedule[]
  substitutions Substitution[]

  lessonPlans LessonPlan[]
}

model Subject {
  id              String             @id @default(uuid())
  name            String             @unique
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  grades          GradeSubject[]
  lessons         Lesson[]
  scheduleItems   ScheduleItem[]
  teachers        SubjectOnTeacher[]
  substitutions   Substitution[]
  weeklyPlanItems WeeklyPlanItem[]

  lessonPlans LessonPlan[]
}

model ClassOnTeacher {
  teacherId String
  classId   String
  class     Class  @relation(fields: [classId], references: [id])
  teacher   User   @relation(fields: [teacherId], references: [id])

  @@id([teacherId, classId])
}

model SubjectOnTeacher {
  teacherId String
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id])
  teacher   User    @relation(fields: [teacherId], references: [id])

  @@id([teacherId, subjectId])
}

model Inquest {
  id                   String         @id @default(uuid())
  inquestType          InquestType
  reason               String
  details              String?
  date                 DateTime       @default(now())
  academicYearId       String
  createdById          String
  teacherId            String
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  clarificationRequest String?
  decisionText         String?
  principalOpinion     String?
  teacherJobTitle      String?
  teacherSchool        String?
  teacherSpecialty     String?
  attachmentUrl        String?
  status               InquestStatus  @default(PENDING)
  teacherClarification String?
  drawAttentionText    String?
  academicYear         AcademicYear   @relation(fields: [academicYearId], references: [id])
  createdBy            User           @relation("InquestsCreated", fields: [createdById], references: [id])
  teacher              User           @relation("InquestsReceived", fields: [teacherId], references: [id])
  notifications        Notification[]
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  body      String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  inquestId String?
  inquest   Inquest? @relation(fields: [inquestId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
}

model AcademicYear {
  id        String    @id @default(uuid())
  name      String    @unique
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean   @default(false)
  inquests  Inquest[]
}

model Announcement {
  id            String                  @id @default(uuid())
  title         String
  body          String
  attachmentUrl String?
  date          DateTime
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  createdById   String
  type          AnnouncementType        @default(GENERAL)
  createdBy     User                    @relation("AnnouncementsCreated", fields: [createdById], references: [id])
  recipients    AnnouncementRecipient[]
}

model AnnouncementRecipient {
  id             String       @id @default(uuid())
  announcementId String
  teacherId      String
  read           Boolean      @default(false)
  readAt         DateTime?
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  teacher        User         @relation(fields: [teacherId], references: [id])

  @@unique([announcementId, teacherId])
}

model Lesson {
  id        String   @id @default(uuid())
  classId   String
  subjectId String
  teacherId String
  date      DateTime
  unit      String
  pages     String
  lesson    String
  objective String
  homework  String?
  createdAt DateTime @default(now())
  comments  String?
  class     Class    @relation(fields: [classId], references: [id])
  subject   Subject  @relation(fields: [subjectId], references: [id])
  teacher   User     @relation(fields: [teacherId], references: [id])
}

model Grade {
  id       String         @id @default(uuid())
  name     String         @unique
  subjects GradeSubject[]
  plans    WeeklyPlan[]
}

model GradeSubject {
  gradeId   String
  subjectId String
  grade     Grade   @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@id([gradeId, subjectId])
}

model WeeklyPlan {
  id        String           @id @default(uuid())
  gradeId   String?
  week      String
  fromDate  DateTime
  toDate    DateTime
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  note      String?
  dictation String?
  grade     Grade?           @relation(fields: [gradeId], references: [id])
  items     WeeklyPlanItem[]
}

model WeeklyPlanItem {
  id           String     @id @default(uuid())
  weeklyPlanId String
  subjectId    String
  unit         String
  lessons      String
  pages        String
  homework     String?
  classwork    String?
  dictation    String?
  subject      Subject    @relation(fields: [subjectId], references: [id])
  weeklyPlan   WeeklyPlan @relation(fields: [weeklyPlanId], references: [id], onDelete: Cascade)
}

model Schedule {
  id        String         @id @default(uuid())
  classId   String
  name      String?
  isActive  Boolean        @default(true)
  createdBy String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  class     Class          @relation(fields: [classId], references: [id])
  creator   User           @relation("ScheduleCreator", fields: [createdBy], references: [id])
  items     ScheduleItem[]

  @@index([classId, isActive])
}

model Substitution {
  id            String   @id @default(uuid())
  date          DateTime
  dayIndex      Int
  session       Int
  start         String
  end           String
  classId       String
  subjectId     String?
  absentId      String
  replacementId String
  createdAt     DateTime @default(now())
  absent        User     @relation("AbsentTeacher", fields: [absentId], references: [id])
  class         Class    @relation(fields: [classId], references: [id])
  replacement   User     @relation("ReplacementTeacher", fields: [replacementId], references: [id])
  subject       Subject? @relation(fields: [subjectId], references: [id])

  @@index([date])
  @@index([absentId])
  @@index([replacementId])
}

model ScheduleItem {
  id         String   @id @default(uuid())
  scheduleId String
  dayIndex   Int
  session    Int
  start      String?
  end        String?
  subjectId  String
  teacherId  String?
  schedule   Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  subject    Subject  @relation(fields: [subjectId], references: [id])
  teacher    User?    @relation(fields: [teacherId], references: [id])

  @@index([scheduleId])
  @@index([teacherId])
  @@index([subjectId])
  @@index([dayIndex, session])
}

model WeeklyReport {
  id                               String    @id @default(uuid())
  teacherId                        String
  weekStart                        DateTime
  teacherData                      Json
  adminData                        Json?
  submittedAt                      DateTime?
  evaluatedAt                      DateTime?
  createdAt                        DateTime  @default(now())
  updatedAt                        DateTime  @updatedAt
  adminActionPlan                  String?
  adminClassroomEnvironment        Int?
  adminClassroomLessonPlanning     Int?
  adminClassroomStudentEngagement  Int?
  adminClassroomStudentFeedback    Int?
  adminClassroomTeachingMethods    Int?
  adminDigitalAssignmentMonitoring Int?
  adminDigitalCommunication        Int?
  adminDigitalPlatformUsage        Int?
  adminEvaluationDate              DateTime?
  adminEvaluationLevel             String?
  adminImprovements                String?
  adminIssuesManagement            Int?
  adminMonitoringAtRisk            Int?
  adminMonitoringHighPerforming    Int?
  adminName                        String?
  adminSignature                   String?
  adminSignatureDate               DateTime?
  adminStrengths                   String?
  adminTeacherLevel                Int?
  adminTotalScore                  Int?
  teacherConfirmDate               DateTime?
  teacherConfirmSignature          String?
  weekEnd                          DateTime?
  teacher                          User      @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId])
  @@index([weekStart])
  @@index([weekEnd])
  @@index([submittedAt])
  @@index([evaluatedAt])
}

model Attendance {
  id        String    @id @default(uuid())
  teacherId String
  checkIn   DateTime
  checkOut  DateTime?
  latitude  Float?
  longitude Float?
  imageUrl  String?
  createdAt DateTime  @default(now())
  teacher   User      @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId])
  @@index([checkIn])
}

model LeaveRequest {
  id        String      @id @default(uuid())
  teacherId String
  leaveDate DateTime
  leaveTime String
  reason    String
  status    LeaveStatus @default(PENDING)
  adminNote String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  teacher   User        @relation(fields: [teacherId], references: [id], onDelete: Cascade)
}

model WorkShift {
  id        String    @id @default(uuid())
  date      DateTime
  startTime DateTime
  endTime   DateTime?
  createdAt DateTime  @default(now())
}

enum Role {
  ADMIN
  TEACHER
  COORDINATOR
}

enum InquestType {
  ABSENT
  NEGLIGENCE
}

enum InquestStatus {
  PENDING
  RESPONDED
  COMPLETED
}

enum AnnouncementType {
  GENERAL
  TARGETED
  DRAW_ATTENTION
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}
model LessonPlan {
  id          String   @id @default(uuid())
  teacherId   String
  classId     String
  grade  String?
  subjectId   String
  date        DateTime? // or String if you prefer to store "18-22/1/2026"
  unit        String
  lessonTopic String
  // Core educational content (long text fields)
  studentOutcomes     String   @db.Text
  vocabularyKeyTerms  String   @db.Text
  warmupDescription   String?  @db.Text
  instructionalDescription String? @db.Text
  proceduresDescription String?  @db.Text
  assessmentDescription String?  @db.Text
  closure             String?  @db.Text
  higherOrderThinking String?  @db.Text

  // Materials (simple booleans + short strings)
  materialsText               Boolean @default(false)
  materialsTextPage           String?
  materialsBoard              Boolean @default(false)
  materialsOverheadProjector  Boolean @default(false)
  materialsVideo              Boolean @default(false)
  materialsLab                Boolean @default(false)
  materialsWebsite            String?
  materialsStudentBook        Boolean @default(false)
  materialsOtherResources     String?

  // Warm-up checkboxes
  warmupQuestions    Boolean @default(false)
  warmupStories      Boolean @default(false)
  warmupRevision     Boolean @default(false)
  warmupVideo        Boolean @default(false)
  warmupHomework     Boolean @default(false)

  // Instructional Delivery checkboxes
  instrReading           Boolean @default(false)
  instrDiscussion        Boolean @default(false)
  instrProblemSolving    Boolean @default(false)
  instrCriticalThinking  Boolean @default(false)
  instrWriting           Boolean @default(false)
  instrIndividual        Boolean @default(false)
  instrWorksheets        Boolean @default(false)
  instrGroupWork         Boolean @default(false)

  // Procedures / Teaching Methods
  procDemonstration       Boolean @default(false)
  procLecture             Boolean @default(false)
  procQa                  Boolean @default(false)
  procReview              Boolean @default(false)
  procTest                Boolean @default(false)
  procIndividual          Boolean @default(false)
  procBrainstorming       Boolean @default(false)
  procProblemSolving      Boolean @default(false)
  procCooperativeLearning Boolean @default(false)
  procDebating            Boolean @default(false)
  procLearningByDoing     Boolean @default(false)
  procRolePlaying         Boolean @default(false)

  // Assessment
  assessTestQuiz            Boolean @default(false)
  assessHomework            Boolean @default(false)
  assessTeacherObservation  Boolean @default(false)
  assessProject             Boolean @default(false)
  assessRevision            Boolean @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  teacher   User    @relation(fields: [teacherId],   references: [id], onDelete: Cascade)
  class     Class   @relation(fields: [classId],    references: [id])
  subject   Subject @relation(fields: [subjectId],  references: [id])

  @@index([teacherId])
  @@index([classId])
  @@index([subjectId])
  @@index([date])
}